---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/projects';

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((project, index) => ({
		params: { slug: project.slug },
		props: { project, index },
	}));
}

interface Props {
	project: CollectionEntry<'projects'>;
	index: number;
}

const { project, index } = Astro.props;
const { title, description, category, tags } = project.data;
const { Content } = await project.render();
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={title} description={description}>
	<header class="container project-header">
		<a href={`${base}projects/`} class="back-link">← All projects</a>
		<p class="kicker">{String(index + 1).padStart(2, '0')} — {category}</p>
		<h1>{title}</h1>
		<p class="lede">{description}</p>
		<ul class="tag-list" aria-label="Tools">
			{tags.map((tag) => <li>{tag}</li>)}
		</ul>
	</header>

	<article class="container">
		<div class="prose">
			<Content />
		</div>
	</article>
</BaseLayout>
