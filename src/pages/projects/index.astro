---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<BaseLayout title="Projects" description="Data analysis, BI and data engineering projects by Alberto Castro.">
	<section class="container section">
		<div class="page-intro">
			<p class="kicker">Portfolio</p>
			<h1>All projects</h1>
			<p class="lede">Data analysis, business intelligence and data engineering work, from raw source to dashboard.</p>
		</div>
		<div class="card-grid">
			{projects.map((project, index) => <ProjectCard project={project} index={index} />)}
		</div>
	</section>
</BaseLayout>
