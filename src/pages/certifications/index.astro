---
import BaseLayout from '../../layouts/BaseLayout.astro';

const transcript =
	'https://learn.microsoft.com/en-us/users/albertocastrojimenez-0038/transcript?tab=tab-learning-paths';

type Row = { name: string; detail?: string; link?: string; linkLabel?: string };
type Group = { title: string; note?: string; columns: [string, string]; rows: Row[] };

const groups: Group[] = [
	{
		title: 'Microsoft Learn — Power BI & Data Analysis',
		note: 'Completed learning paths (November 2025). PL-300 course completed, exam pending.',
		columns: ['learning path', 'proof'],
		rows: [
			{ name: 'Get Started with Microsoft Data Analytics', link: transcript, linkLabel: 'transcript' },
			{ name: 'Prepare Data for Analysis with Power BI', link: transcript, linkLabel: 'transcript' },
			{ name: 'Prepare and Visualize Data with Microsoft Power BI', link: transcript, linkLabel: 'transcript' },
		],
	},
	{
		title: 'Microsoft & Azure — Data & Cloud',
		note: 'Issued by Microsoft, delivered through Coursera.',
		columns: ['course', 'proof'],
		rows: [
			{ name: 'Explore Core Data Concepts in Microsoft Azure', link: 'https://www.coursera.org/account/accomplishments/verify/GZEYNTWE4PAH', linkLabel: 'verify' },
			{ name: 'Microsoft Azure SQL', link: 'https://www.coursera.org/account/accomplishments/verify/A3PYQEFN6SHS', linkLabel: 'verify' },
			{ name: 'Microsoft Azure Cosmos DB', link: 'https://www.coursera.org/account/accomplishments/verify/YXTKT3G62MAB', linkLabel: 'verify' },
			{ name: 'Modern Data Warehouse Analytics in Microsoft Azure', link: 'https://www.coursera.org/account/accomplishments/verify/EHF9LS4C57HL', linkLabel: 'verify' },
		],
	},
	{
		title: 'Generative AI',
		columns: ['course', 'proof'],
		rows: [
			{ name: 'AI-Powered Software and System Design', link: 'https://www.coursera.org/account/accomplishments/certificate/H13DV2S7C683', linkLabel: 'verify' },
			{ name: 'Generative AI for Everyone', link: 'https://www.coursera.org/account/accomplishments/certificate/1JGUH1RK9QCJ', linkLabel: 'verify' },
			{ name: 'Gen AI Training Path — Foundational Track', link: 'https://www.coursera.org//account/accomplishments/badge/jEnXgYCxTdeJ14GAsd3Xzg', linkLabel: 'verify' },
			{ name: 'Gen AI Training Path — Technical Track', link: 'https://www.coursera.org//account/accomplishments/badge/sDqpF-8iSya6qRfvItsmiw', linkLabel: 'verify' },
		],
	},
	{
		title: 'Data Analytics, BI & Python',
		columns: ['course', 'issuer'],
		rows: [
			{ name: 'Storytelling With Data', detail: 'Udemy · 2023' },
			{ name: 'Power BI Business Intelligence', detail: 'G-Talent · 2022' },
			{ name: 'Introduction to Python', detail: 'Noax Academy · 2022' },
		],
	},
	{
		title: 'Education',
		columns: ['degree', 'institution'],
		rows: [
			{ name: 'Bachelor’s Degree in Software Engineering', detail: 'UTN · 2021' },
			{ name: 'Diploma in Information Technologies', detail: 'UTN · 2020' },
		],
	},
];
---

<BaseLayout title="Certifications" description="Certifications and academic background of Alberto Castro, Data Analyst.">
	<section class="container section">
		<div class="page-intro">
			<p class="kicker">Learning</p>
			<h1>Certifications &amp; education</h1>
			<p class="lede">
				Every certification below is publicly verifiable. Microsoft Learn progress is available in my
				<a href={transcript} target="_blank" rel="noopener noreferrer">public transcript</a>.
			</p>
		</div>

		{
			groups.map((group) => (
				<div class="cert-group">
					<h2>{group.title}</h2>
					{group.note && <p>{group.note}</p>}
					<div class="table-wrap">
						<table class="data-table">
							<thead>
								<tr>
									<th scope="col">{group.columns[0]}</th>
									<th scope="col">{group.columns[1]}</th>
								</tr>
							</thead>
							<tbody>
								{group.rows.map((row) => (
									<tr>
										<td>{row.name}</td>
										<td>
											{row.link ? (
												<a href={row.link} target="_blank" rel="noopener noreferrer">
													{row.linkLabel} ↗
												</a>
											) : (
												(row.detail ?? '—')
											)}
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</div>
			))
		}
	</section>
</BaseLayout>
