---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/projects';
import { CV_FILE, EMAIL, LINKEDIN_URL } from '../consts';
import portrait from '../assets/about.jpg';

const base = import.meta.env.BASE_URL;
const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
---

<BaseLayout>
	<section class="container hero">
		<div class="hero-copy">
			<p class="kicker">Data Analyst</p>
			<h1 class="hero-title">I turn raw data into <em>decisions</em> teams can act on.</h1>
			<p class="lede">
				I’m Alberto Castro, a Data Analyst with a Software Engineering background and 6+ years working with
				cross-functional teams across the U.S. and the U.K.
			</p>
			<div class="btn-row">
				<a href="#work" class="btn btn-primary">See selected work</a>
				<a href={`${base}${CV_FILE}`} class="btn" download>Download CV</a>
			</div>
		</div>
		<div class="hero-photo">
			<Image src={portrait} alt="Portrait of Alberto Castro" width={720} loading="eager" />
		</div>
	</section>

	<section class="container" aria-label="Highlights">
		<dl class="highlights">
			<div><dt>6+ years</dt><dd>with cross-functional teams</dd></div>
			<div><dt>U.S. &amp; U.K.</dt><dd>teams and stakeholders</dd></div>
			<div><dt>B.Sc.</dt><dd>Software Engineering, UTN</dd></div>
			<div><dt>PL-300</dt><dd>Power BI certification in progress</dd></div>
		</dl>
	</section>

	<section id="work" class="container section">
		<div class="section-head">
			<h2>Selected work</h2>
			<a href={`${base}projects/`} class="text-link">All projects →</a>
		</div>

		{featured.map((project) => <ProjectCard project={project} index={projects.indexOf(project)} variant="feature" />)}

		{
			others.length > 0 && (
				<div class="card-grid">
					{others.map((project) => (
						<ProjectCard project={project} index={projects.indexOf(project)} />
					))}
				</div>
			)
		}
	</section>

	<section id="about" class="band">
		<div class="container about">
			<div class="about-intro">
				<p class="kicker">About</p>
				<h2>From CRM development to data analysis.</h2>
			</div>
			<div class="about-body">
				<p>
					My career began in CRM and email development, where I worked daily with PMs, designers and engineering
					teams to solve technical problems and deliver data-driven components used by thousands of users.
				</p>
				<p>
					Moving into data was a natural evolution. Today I work on projects focused on data cleaning, modeling
					and visualization, turning raw information into something clear, usable and valuable.
				</p>
				<h3 class="toolkit-title">Toolkit</h3>
				<dl class="toolkit">
					<div><dt>SQL</dt><dd>T-SQL, views, CTEs, data modeling</dd></div>
					<div><dt>Power BI</dt><dd>Power Query, DAX, dashboards</dd></div>
					<div><dt>Python</dt><dd>Pandas, NumPy, ETL automation</dd></div>
					<div><dt>Excel</dt><dd>Analysis and reporting</dd></div>
				</dl>
			</div>
		</div>
	</section>

	<section id="certs" class="container section">
		<div class="section-head">
			<h2>Certifications</h2>
			<a href={`${base}certifications/`} class="text-link">All certifications →</a>
		</div>
		<ul class="cert-summary">
			<li>
				<h3>Power BI &amp; Data Analysis</h3>
				<p>Microsoft Learn · 3 learning paths completed, PL-300 exam pending</p>
			</li>
			<li>
				<h3>Azure Data &amp; Cloud</h3>
				<p>Microsoft via Coursera · Azure SQL, Cosmos DB, Data Warehouse</p>
			</li>
			<li>
				<h3>Generative AI</h3>
				<p>Coursera · 4 courses, incl. AI-Powered Software and System Design</p>
			</li>
			<li>
				<h3>Data, Python &amp; R</h3>
				<p>Storytelling With Data, Introduction to Python, R for Data Science</p>
			</li>
		</ul>
	</section>

	<section id="contact" class="container contact">
		<p class="kicker">Contact</p>
		<h2 class="contact-title">Let’s work <em>together</em>.</h2>
		<p class="lede">If you’re looking for someone analytical, curious and structured, I’d love to connect.</p>
		<div class="btn-row">
			<a href={`mailto:${EMAIL}`} class="btn btn-primary">{EMAIL}</a>
			<a href={LINKEDIN_URL} class="btn" target="_blank" rel="noopener noreferrer">LinkedIn</a>
		</div>
	</section>
</BaseLayout>
