---
import { CV_FILE } from '../consts';

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const isCerts = path.startsWith(`${base}certifications`);
const isProjects = path.startsWith(`${base}projects`);
---

<header class="site-header">
	<nav class="container nav" aria-label="Main">
		<a href={base} class="brand" translate="no">Alberto Castro</a>

		<div class="nav-links" id="navLinks">
			<a href={`${base}projects/`} aria-current={isProjects ? 'page' : undefined}>Work</a>
			<a href={`${base}#about`}>About</a>
			<a href={`${base}certifications/`} aria-current={isCerts ? 'page' : undefined}>Certifications</a>
			<a href={`${base}#contact`}>Contact</a>
			<a href={`${base}${CV_FILE}`} class="cv-link" download>Download CV</a>
		</div>

		<div class="nav-actions">
			<button type="button" class="icon-btn theme-toggle" id="themeToggle" aria-label="Switch color theme">
				<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
				</svg>
				<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
				</svg>
			</button>
			<button type="button" class="icon-btn menu-toggle" id="menuToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>
		</div>
	</nav>
</header>

<script>
	const themeToggle = document.getElementById('themeToggle');
	themeToggle?.addEventListener('click', () => {
		const root = document.documentElement;
		const next = root.dataset.theme === 'light' ? 'dark' : 'light';
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {}
	});

	const menuToggle = document.getElementById('menuToggle');
	const navLinks = document.getElementById('navLinks');
	menuToggle?.addEventListener('click', () => {
		const open = navLinks?.classList.toggle('open') ?? false;
		menuToggle.setAttribute('aria-expanded', String(open));
		menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
	});
	// Close the mobile menu after jumping to a section
	navLinks?.addEventListener('click', (event) => {
		if ((event.target as HTMLElement).closest('a')) {
			navLinks.classList.remove('open');
			menuToggle?.setAttribute('aria-expanded', 'false');
		}
	});
</script>
